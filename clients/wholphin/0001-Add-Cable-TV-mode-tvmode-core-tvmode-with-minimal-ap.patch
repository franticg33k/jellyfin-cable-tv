+private fun Provider<String>.getInt() = get().toInt()
+
+android {
+    namespace = "com.github.damontecres.wholphin.tvmode"
+    compileSdk {
+        version = release(libs.versions.compileSdk.getInt())
+    }
+
+    defaultConfig {
+        minSdk = libs.versions.minSdk.getInt()
