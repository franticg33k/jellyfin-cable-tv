<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.CableTv</RootNamespace>
    <AssemblyVersion>0.5.6.0</AssemblyVersion>
    <FileVersion>0.5.6.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime; never copy into the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <!-- Jellyfin ships SkiaSharp (its image processing uses it); the plugin uses the server's copy to draw logos. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Logos\Oswald.ttf" />
    <EmbeddedResource Include="Web\tv.html" />
    <EmbeddedResource Include="Web\hls.light.min.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.CableTv.Tests" />
  </ItemGroup>

</Project>
